[Unit]
Description=MRDVS collector Wi-Fi hotspot
Wants=NetworkManager.service
After=NetworkManager.service
Before=mrdvs-web-console.service
PartOf=mrdvs-collector.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/mrdvs-system-helper hotspot-up
ExecStop=/usr/local/libexec/mrdvs-system-helper hotspot-down
TimeoutStartSec=30
TimeoutStopSec=20

[Install]
WantedBy=mrdvs-collector.target
